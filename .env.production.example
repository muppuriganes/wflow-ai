# Production settings for docker-compose.prod.yml. Copy to .env.production (never commit it) and replace
# every value. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start in production while any of the guarded values below is missing or a default.

ENVIRONMENT=production

# --- Database / cache / storage (also used by the compose services themselves) ---
POSTGRES_DB=wflow
POSTGRES_USER=wflow_owner
POSTGRES_PASSWORD=replace-with-a-long-random-value
APP_DB_PASSWORD=replace-with-a-different-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
S3_ACCESS_KEY=replace-with-a-bucket-scoped-access-key
S3_SECRET_KEY=replace-with-its-secret
S3_BUCKET=wflow-files
S3_PUBLIC_ENDPOINT_URL=https://files.example.com

# --- Public URLs (one origin per line of CORS_ORIGINS, comma separated) ---
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
PUBLIC_API_URL=https://app.example.com

# --- Guarded secrets (startup fails if left as defaults) ---
JWT_SECRET=replace-with-48-random-characters
COOKIE_SECURE=true
INTERNAL_API_TOKEN=replace-with-48-random-characters
CREDENTIALS_ENCRYPTION_KEY=replace-with-48-random-characters  # changing it later makes saved credentials unreadable
STRIPE_WEBHOOK_SECRET=whsec_from_your_payment_provider
STRIPE_SECRET_KEY=sk_live_or_restricted_key
BILLING_TEST_MODE=false
SIMULATOR_ENABLED=false
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
WORKFLOW_TIME_SCALE=1

# --- Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace
SMTP_PASSWORD=replace
SMTP_USE_TLS=true
EMAIL_FROM=WFlow AI <no-reply@example.com>

# --- Workflow engine ---
TEMPORAL_NAMESPACE=wflow
TEMPORAL_TASK_QUEUE=wflow-workflows
LOG_LEVEL=INFO
ORG_APPROVAL_REQUIRED=true
