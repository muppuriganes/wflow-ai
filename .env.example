# Copy to .env and adjust. Never commit .env.
# Host ports are deliberately non-default so WFlow can run beside other local stacks.
# Backend URLs use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and
# stalls ~2s per new connection because the containers only listen on IPv4 loopback.

ENVIRONMENT=development

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST_PORT=55432
POSTGRES_DB=wflow
POSTGRES_USER=wflow_owner          # owns the schema, runs migrations
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app      # password for the runtime role "wflow_app" (RLS enforced)

# Runtime connection (non-owner role, subject to Row Level Security)
DATABASE_URL=postgresql+asyncpg://wflow_app:change-me-app@127.0.0.1:55432/wflow
# Migration / admin connection (schema owner)
DATABASE_ADMIN_URL=postgresql+asyncpg://wflow_owner:change-me-owner@127.0.0.1:55432/wflow
# Used by the backend test-suite (database is created by the postgres init script)
TEST_DATABASE_URL=postgresql+asyncpg://wflow_app:change-me-app@127.0.0.1:55432/wflow_test
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://wflow_owner:change-me-owner@127.0.0.1:55432/wflow_test

# --- Redis --------------------------------------------------------------------
REDIS_HOST_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# --- MinIO (S3-compatible file storage) ---------------------------------------
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
MINIO_ROOT_USER=wflow-minio
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_BUCKET=wflow-files

# --- Email (Mailpit catches all mail in development: http://localhost:58025) --
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_UI_HOST_PORT=58025
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=WFlow AI <no-reply@wflow.local>

# --- Backend ------------------------------------------------------------------
API_HOST_PORT=8100
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5180
CORS_ORIGINS=http://localhost:5180
LOG_LEVEL=INFO

# --- Frontend -----------------------------------------------------------------
WEB_HOST_PORT=5180
VITE_API_BASE_URL=http://localhost:8100/api/v1

# --- Messaging gateway (services/messaging-gateway) ----------------------------
GATEWAY_HOST_PORT=8200
GATEWAY_URL=http://127.0.0.1:8200
# Backend URL the gateway calls to restore sessions after a restart
BACKEND_INTERNAL_URL=http://127.0.0.1:8100
# Shared secret for backend <-> gateway calls. Generate like JWT_SECRET.
INTERNAL_API_TOKEN=change-me-internal-token
MAX_CONNECTIONS_PER_ORG=3
CHANNEL_SEND_LIMIT_PER_MINUTE=20
# Development/demo channel that fakes QR scans and inbound messages. Must be false in production.
SIMULATOR_ENABLED=true
# Gateway: hard cap on concurrently running sessions (each WhatsApp session is a headless Chromium)
GATEWAY_MAX_SESSIONS=10
